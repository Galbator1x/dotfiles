[includeIf "gitdir:~/projects/work/"]
	path = ~/projects/dotfiles/files/gitconfig-work
[core]
  pager = diff-so-fancy | less --tabs=4 -RFX
[color "diff-highlight"]
  oldHighlight = "231 52"
  newHighlight = "231 22"
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
	autoupdate = false
