# Avoid registering shell integrations twice when this file is sourced again.
[[ ${_DOTFILES_BASHRC_LOADED:-} == 1 ]] && return

# Add configured paths only when they are not already inherited from the parent.
_dotfiles_path() {
    case ":$PATH:" in
        *":$2:"*) return ;;
    esac
    if [[ $1 == prepend ]]; then
        export PATH="$2:$PATH"
    else
        export PATH="$PATH:$2"
    fi
}
_dotfiles_path append "$HOME/.docker/bin"

export EDITOR=nvim
export VISUAL=nvim
export BASH_SILENCE_DEPRECATION_WARNING=1
export LC_ALL=en_US.UTF-8

_dotfiles_path prepend /opt/homebrew/bin
_dotfiles_path prepend "$HOME/nvim-macos-arm64/bin"

# Raise the soft open-file limit without lowering an existing higher limit.
if [[ $(ulimit -Sn) != unlimited ]] && (( $(ulimit -Sn) < 8192 )); then
    ulimit -Sn 8192
fi

# If not running interactively, don't do anything
case $- in
    *i*) ;;
    *)
        unset -f _dotfiles_path
        return
        ;;
esac
_DOTFILES_BASHRC_LOADED=1

# History and interactive shell options.
HISTCONTROL=ignoreboth

HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend checkwinsize
set -o vi

# Share new history entries between open Bash sessions before each prompt.
sync_bash_history() {
    local previous_exit_status=$?
    builtin history -a
    builtin history -n
    return "$previous_exit_status"
}
if [[ " ${precmd_functions[*]} " != *" sync_bash_history "* ]]; then
    precmd_functions+=(sync_bash_history)
fi

# Prompt and completion.
source "${HOMEBREW_PREFIX:-/opt/homebrew}/etc/bash_completion.d/git-prompt.sh"
PS1='$(__git_ps1) \W\$ '

# Load Homebrew's programmable completion.
if ! shopt -oq posix && [[ -r "${HOMEBREW_PREFIX:-/opt/homebrew}/etc/profile.d/bash_completion.sh" ]]; then
    source "${HOMEBREW_PREFIX:-/opt/homebrew}/etc/profile.d/bash_completion.sh"
fi

# Aliases and helper functions.
if [[ -f "$HOME/.bash_aliases" ]]; then
    source "$HOME/.bash_aliases"
fi

gch() {
    local branch
    branch=$(git branch --format='%(refname:short)' | fzf) || return 0
    [[ -n "$branch" ]] || return 0
    git checkout "$branch"
}

nvim-update() {
    python3 "$HOME/projects/dotfiles/scripts/nvim-manager.py" update "$@"
}

nvim-rollback() {
    python3 "$HOME/projects/dotfiles/scripts/nvim-manager.py" rollback "$@"
}

nvim-versions() {
    python3 "$HOME/projects/dotfiles/scripts/nvim-manager.py" list
}

# Show the running command, then the directory and last command, in the terminal title.
case "$TERM" in
    xterm*|rxvt*)
        terminal_title_command=""

        set_terminal_command_title() {
            local command=$1
            command=${command//[$'\001'-$'\037'$'\177']/} # Strip terminal control characters.
            terminal_title_command=${command#sudo }
            terminal_title_command=${terminal_title_command%% *}
            printf '\033]0;%s\007' "$command"
        }

        set_terminal_prompt_title() {
            local directory=${PWD##*/}
            [[ $PWD == "$HOME" ]] && directory='~'
            [[ $PWD == / ]] && directory=/
            directory=${directory//[$'\001'-$'\037'$'\177']/}
            printf '\033]0;%s\007' "${directory}${terminal_title_command:+: $terminal_title_command}"
        }

        if [[ " ${preexec_functions[*]} " != *" set_terminal_command_title "* ]]; then
            preexec_functions+=(set_terminal_command_title)
        fi
        if [[ " ${precmd_functions[*]} " != *" set_terminal_prompt_title "* ]]; then
            precmd_functions+=(set_terminal_prompt_title)
        fi
        ;;
esac

# Tool integrations.
_dotfiles_path prepend "$HOME/.rbenv/bin"
eval "$(rbenv init -)"
_dotfiles_path prepend "$HOME/.rbenv/plugins/ruby-build/bin"

if command -v fzf >/dev/null 2>&1; then
    eval "$(fzf --bash)"
fi
_dotfiles_path append "$HOME/.local/bin"
unset -f _dotfiles_path

# Keep Ruby managed by rbenv until the migration to mise.
export MISE_DISABLE_TOOLS=ruby
if command -v mise >/dev/null 2>&1; then
    eval "$(command mise activate bash)"
fi

# iTerm2 bundles bash-preexec, which runs the history and title hooks above.
if [[ ${TERM_PROGRAM:-} == iTerm.app ]] && [[ -r /Applications/iTerm.app/Contents/Resources/iterm2_shell_integration.bash ]]; then
    source /Applications/iTerm.app/Contents/Resources/iterm2_shell_integration.bash
fi
